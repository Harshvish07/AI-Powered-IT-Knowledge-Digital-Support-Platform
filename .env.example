# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=itsupport
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/itsupport
# One of: development, test, production. See docs/deployment.md — setting
# this to `production` activates a startup check (app/core/config.py,
# assert_production_safe) that refuses to boot if any of the settings below
# still have an insecure development default.
ENVIRONMENT=development
# Set to true only while actively debugging locally — it makes unhandled
# exceptions return full tracebacks in the HTTP response body. Never true
# anywhere reachable outside your own machine (and never true at all in
# production — the app refuses to start otherwise).
DEBUG=false
# One of: DEBUG, INFO, WARNING, ERROR. Logs are JSON in production, plain
# text otherwise — see app/core/logging_config.py.
LOG_LEVEL=INFO
# SQLAlchemy connection pool sizing — safe to leave as-is for a single
# backend instance; see docs/deployment.md "Performance considerations"
# before changing.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ---- Auth ----
# Generate a strong random value for any non-local environment, e.g.:
#   openssl rand -hex 32
# The default below is for local development ONLY — never use it in production.
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=false

# ---- Dev-only admin seed (scripts/seed-admin.sh) ----
# Leave both blank to skip seeding. Never set real/production credentials
# here — this script refuses to run at all when ENVIRONMENT=production. To
# create the first admin on a real deployment: have that person register a
# normal account through the app, then run
# `docker compose exec backend python -m app.scripts.promote_to_admin <email>`
# (see docs/deployment.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Admin

# ---- Knowledge base / document ingestion ----
# Google Gemini API key — required for embedding generation. Leave blank to
# disable it; uploads will fail at the embedding step and the document will be
# marked FAILED rather than crash. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MAX_UPLOAD_SIZE_MB=20
UPLOAD_STORAGE_DIR=storage/uploads
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
# Changing either of these after documents exist requires a new migration for
# document_chunks.embedding and a full reindex of existing documents.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# ---- RAG / AI assistant ----
CHAT_MODEL=gemini-3.6-flash
CHAT_MAX_OUTPUT_TOKENS=1024
# How many chunks to retrieve from pgvector before similarity filtering.
RAG_TOP_K=5
# Minimum cosine similarity for a chunk to be used as grounding evidence.
# See app/core/config.py for how this default was measured.
RAG_SIMILARITY_THRESHOLD=0.55

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
