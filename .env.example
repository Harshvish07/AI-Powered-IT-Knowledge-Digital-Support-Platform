# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=itsupport
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/itsupport
ENVIRONMENT=development
DEBUG=true

# ---- Auth ----
# Generate a strong random value for any non-local environment, e.g.:
#   openssl rand -hex 32
# The default below is for local development ONLY — never use it in production.
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=false

# ---- Dev-only admin seed (scripts/seed-admin.sh) ----
# Leave both blank to skip seeding. Never set real/production credentials here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Admin

# ---- Knowledge base / document ingestion ----
# Google Gemini API key — required for embedding generation. Leave blank to
# disable it; uploads will fail at the embedding step and the document will be
# marked FAILED rather than crash. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MAX_UPLOAD_SIZE_MB=20
UPLOAD_STORAGE_DIR=storage/uploads
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
# Changing either of these after documents exist requires a new migration for
# document_chunks.embedding and a full reindex of existing documents.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# ---- RAG / AI assistant ----
CHAT_MODEL=gemini-3.6-flash
CHAT_MAX_OUTPUT_TOKENS=1024
# How many chunks to retrieve from pgvector before similarity filtering.
RAG_TOP_K=5
# Minimum cosine similarity for a chunk to be used as grounding evidence.
# See app/core/config.py for how this default was measured.
RAG_SIMILARITY_THRESHOLD=0.55

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
