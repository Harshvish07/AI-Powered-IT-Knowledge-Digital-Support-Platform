DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/itsupport
# One of: development, test, production — see docs/deployment.md.
# `production` activates a startup check (assert_production_safe in
# app/core/config.py) that refuses to boot with an insecure default below.
ENVIRONMENT=development
# Set to true only while actively debugging locally — it makes unhandled
# exceptions return full tracebacks in the HTTP response body. Never true
# anywhere reachable outside your own machine (and never true in production —
# the app refuses to start otherwise).
DEBUG=false
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# SQLAlchemy connection pool sizing — safe to leave as-is for a single
# backend instance; see docs/deployment.md "Performance considerations".
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ---- Auth ----
# Dev-only default — never use this value outside local development.
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-deploying-anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ---- Dev-only admin seed (python -m app.scripts.seed_admin) ----
# Refuses to run when ENVIRONMENT=production. To create the first admin on a
# real deployment: register a normal account through the app, then run
# `python -m app.scripts.promote_to_admin <email>` (works in any environment).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Admin

# ---- Knowledge base / document ingestion ----
# Google Gemini API key — required for embedding generation.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
MAX_UPLOAD_SIZE_MB=20
UPLOAD_STORAGE_DIR=storage/uploads
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
# Changing either of these after documents exist requires a new migration for
# document_chunks.embedding and a full reindex of existing documents.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# ---- RAG / AI assistant ----
CHAT_MODEL=gemini-3.6-flash
CHAT_MAX_OUTPUT_TOKENS=1024
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
