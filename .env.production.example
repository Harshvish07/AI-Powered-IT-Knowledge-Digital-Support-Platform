# Production environment template. Copy to `.env` on the production host (or
# translate into your platform's secret/env store — never commit the real
# file), fill in every placeholder, then see docs/deployment.md.
#
# Everything below that differs from .env.example's development defaults is
# checked at startup (assert_production_safe, app/core/config.py) — the app
# refuses to boot with ENVIRONMENT=production if any of these are still
# left at an insecure development value.

# ---- PostgreSQL ----
# Prefer a managed Postgres provider in production (see docs/deployment.md);
# these values matter only if you're running the bundled postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
POSTGRES_DB=itsupport
POSTGRES_PORT=5432

# ---- Backend ----
BACKEND_PORT=8000
# If using a managed Postgres provider instead of the bundled container,
# point this at it directly (usually requires ?sslmode=require).
DATABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_A_LONG_RANDOM_VALUE@postgres:5432/itsupport
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ---- Auth ----
# Generate with: openssl rand -hex 32 — never reuse the development default.
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Requires the app to actually be served over HTTPS (e.g. behind a reverse
# proxy that terminates TLS) — otherwise the browser will silently refuse to
# send the refresh-token cookie at all.
COOKIE_SECURE=true

# ---- Admin bootstrap ----
# Leave blank — the dev seed script refuses to run in production anyway.
# Create the first admin by registering a normal account through the app,
# then: docker compose exec backend python -m app.scripts.promote_to_admin <email>
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Admin

# ---- Knowledge base / document ingestion ----
GEMINI_API_KEY=REPLACE_WITH_A_REAL_GEMINI_API_KEY
MAX_UPLOAD_SIZE_MB=20
UPLOAD_STORAGE_DIR=storage/uploads
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# ---- RAG / AI assistant ----
CHAT_MODEL=gemini-3.6-flash
CHAT_MAX_OUTPUT_TOKENS=1024
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55

# ---- Frontend ----
FRONTEND_PORT=3000
# Your real, public backend origin — never localhost. This must also be
# passed as a Docker build ARG (see docker-compose.prod.yml), not just here:
# it's inlined into the client-side JS bundle at build time.
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.example

# ---- CORS ----
# The backend's CORS_ORIGINS defaults to a Python list in code
# (app/core/config.py) with a single localhost entry. pydantic-settings
# parses a JSON array from the environment for a list field, so override it
# like this with your real frontend origin(s):
CORS_ORIGINS=["https://app.yourdomain.example"]
